@startuml
participant Main
participant StreamingClass
participant User
participant Media
participant FileIO
participant TextUI

Main -> StreamingClass : startStreaming()
activate StreamingClass

StreamingClass -> FileIO : assignUser()
activate FileIO
FileIO --> StreamingClass
deactivate FileIO

loop programIsRunning
    StreamingClass -> TextUI : showMenu()
    activate TextUI
    TextUI --> StreamingClass : String
    deactivate TextUI
end

StreamingClass -> FileIO : saveData()
activate FileIO
FileIO --> StreamingClass
deactivate FileIO

StreamingClass --> Main
deactivate StreamingClass
@enduml