@startuml
class Main{
+ static void main(String[] args)

}

class StreamingService{
- String name
- User user
- ArrayList<Media>
+ void start()
- ArrayList<Media> getMediaByName()
- ArrayList<Media> getMediaByCategory()

- void createUser(String, String)
- void checkCredentials(String, String)
- void loadUser(String)
- void saveUser(User)

- void loadMovieData(String)
- void loadSeriesData(String)

- void addMedia(Media)
- ArrayList<Media> getMedia()
}




abstract class Media{
# String name
# Arraylist category
# int date
# double rating
# int ID
+ Media(String, int, ArrayList<String>, double)
+ abstract void play()

}
interface Playable {
void play();
}


class Episode implements Playable {
- final String episode
- final Series parent
+ Episode(Series, String)
+ String getEpisode()
+ void play()
}

class Movie implements Playable{
+ Movie(String, int, ArrayList<String>, double)
}

class Series {
- ArrayList<Episode> episodes
+ Series(String, ArrayList<String>, int, double, ArrayList<String>)
- boolean addEpisode(Episode)
+ ArrayList<Episode> getEpisodes()
}

package "menu"{
class PageBuilder{
- final Deque<PageTemplate> history
- PageTemplate current
- boolean running
+ void goTo(PageTemplate)
+ PageTemplate back()
+ void exit()
+ boolean isRunning()
+ PageTemplate getCurrent()
+ void select(PageTemplate)
+ void display()
}

class PageTemplate{
- String title
- final ArrayList<Runnable> action
- final ArrayList<String> options
+ PageTemplate(String)
+ void addSingleOptions(String[], Runnable...)
+ void addListOptions(List<String>, Consumer<Integer>)
+ void choice(int)
+ ArrayList<String> getOptions()
+ void clearOptions(int, int)
+ void setTitle(String)
+ String getTitle()
}

class MenuDisplay{
- final PageBuilder builder
+ void showMenu()
}
}


class User{
- String name
- String password
- ArrayList<Media> watchedMedia
- ArrayList<Media> savedMedia
+ User(String, String)
+ void addHistory(Media)
+ void addSaved(Media)

+ void clearHistory()
+ void deleteFromHistory(Media)
+ void deleteFromSaved()

+ Arraylist<Media> getWatched()
+ Arraylist<Media> getSaved()
}

package "util"{
class FileIO{
+ {static} ArrayList<String> readData(String)
+ {static} String[] readData(String, int)
+ {static} void saveData(String, String, ArrayList<String>)
}

class TexUI{
+ {static} void userMessage(String)
+ {static} String promptText(String)
+ {static} boolean promptBinary(String)
+ {static} int promptNumeric(String)
+ {static} ArrayList<String> promptChoice(ArrayList<String>, int, String)
+ {static} void displayList(ArrayList<String>, String, boolean)
+ {static} int promptMenuChoice(ArrayList<String>, String)

}

class PasswordEncryption{
- {static} final int ITTERATIONS
- {static} final int KEY_LENGTH
+ {static} byte[] saltGenerator()
+ {static} byte[] hash(char[], byte[])
+ {static} String createStoredKey(char[])
+ {static} boolean checkPassword(char[], String)
}




}

Main *-- StreamingService
StreamingService *-- Media
StreamingService *-- FileIO
StreamingService *-- TexUI
StreamingService *-- User
StreamingService *-- PageBuilder
StreamingService *-- PageTemplate
PageBuilder o-- PageTemplate
PageBuilder --> TexUI
Media <|-- Movie
Media <|-- Series
Series *-- Episode
StreamingService *-- PasswordEncryption
MenuDisplay *-- PageBuilder
MenuDisplay --> PageTemplate
MenuDisplay --> TexUI

@enduml