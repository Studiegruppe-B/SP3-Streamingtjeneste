@startuml
class Main{
+ static void main(String[] args)

}

class StreamingService{
- ArrayList<Movie> movies
- ArrayList<Series> series
+ startStreamingService()
- displayMenu()
- ArrayList<Media> getMediaByName()
- ArrayList<Media> getMediaByCategory()
}




abstract class Media{
# String name
# Arraylist category
# int date
# double rating
+ Media(String, int, ArrayList<String>, double)
# play()
}

class Movie{
+ Movie(String, int, ArrayList<String>, double)
}

class Series{
+ Series(String, int, ArrayList<String>, double, seasons, episodes)
- int seasons
- int episodes
}

class User{
- String name
- String password
- ArrayList<Media> watchedMedia
- ArrayList<Media> savedMedia
+ addToHistory(Media)
+ addToWatchLater(Media)
+ deleteHistory()
+ deleteFromHistory(Media)
+ Arraylist<Media> getWatchedList()
+ Arraylist<Media> getSavedMedia()
}

package "util"{
static class FileIO{
+ readData(String)
+ readData(String, int)
+ saveData(String, String, ArrayList<String>)
}

static class TexUI{
+ void userMessage(String)
+ String promptText(String)
+ boolean promptBinary(String)
+ int promptNumeric(String)
+ ArrayList<String> promptChoice(ArrayList<String>, int, String)
+ void displayList(ArrayList<String>, String, boolean)
+ int promptMenuChoice(ArrayList<String>, String)

}
}

Main *-- StreamingService
StreamingService *-- Media
StreamingService *-- FileIO
StreamingService *-- TexUI
StreamingService *-- User
Media <|-- Movie
Media <|-- Series
@enduml