@startuml
class Main{
+ static void main(String[] args)

}

class StreamingService{
- Arraylist movies
- Arraylist series
+ startStreamingService()
- showMenu()
- ArrayList<Media> getMediaByName()
- ArrayList<Media> getMediaByCategory()
}




abstract class Media{
# String name
# Arraylist category
# int date
# double rating
+ Media(String, int, ArrayList<String>, double)
# play()
}

class Movie{
+ Movie(String, int, ArrayList<String>, double)
}

class Series{
+ Series(String, int, ArrayList<String>, double, seasons, episodes)
- int seasons
- int episodes
}

class User{
- String name
- String password
- ArrayList watchedMovies
- ArrayList savedMovies
+ addToHistory(Media)
+ addToWatch(Media)
+ deleteHistory()
+ deleteFromHistory(Media)
+ Arraylist<Media> showWatchedList()
+ Arraylist<Media> showToWatchList()
}

package "util"{
static class FileIO{
+ readData(String path)
+ saveData(String path)
}

static class TexUI{
+ userMessage()
+ String promptUser()
+ boolean promptBinary()

}
}

Main *-- StreamingService
StreamingService *-- Media
StreamingService *-- FileIO
StreamingService *-- TexUI
StreamingService *-- User
Media <|-- Movie
Media <|-- Series
@enduml